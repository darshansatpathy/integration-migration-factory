# Generated by imf from estate/flows/{{ flow.id }}.xml. Do not edit: change the flow or the template.
topics:
  - name: {{ topic }}
    partitions: 3
    replication_factor: 3
    config:
      min.insync.replicas: "2"
      cleanup.policy: delete
      retention.ms: "{{ retention_ms }}"
      compression.type: zstd
    key: {{ flow.key | j }}
    value_schema: schema.json
  - name: {{ dlq_topic }}
    partitions: 1
    replication_factor: 3
    config:
      min.insync.replicas: "2"
      cleanup.policy: delete
      retention.ms: "{{ retention_ms * 2 }}"
    description: records rejected by ingest, with the reason and the original source line
owner: {{ flow.owner }}
classification: {{ flow.classification }}
