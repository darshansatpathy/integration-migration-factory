# Generated by imf. Topics shared by every migrated flow.
topics:
  - name: {{ control_topic }}
    partitions: 1
    replication_factor: 3
    config:
      min.insync.replicas: "2"
      cleanup.policy: compact,delete
      retention.ms: "2592000000"
    description: one control message per batch (record count, rejections and control totals), keyed by flow and batch
flows:
{% for f in flows %}
  - {{ f.id }}
{% endfor %}
