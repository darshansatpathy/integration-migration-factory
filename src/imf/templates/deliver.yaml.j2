# Generated by imf from estate/flows/{{ flow.id }}.xml. Do not edit: change the flow or the template.
flow: {{ flow.id }}
topic: {{ topic }}
control_topic: {{ control_topic }}
consumer_group: imf.deliver.{{ flow.id | lower }}
target:
{% for k, v in target.items() %}
  {{ k }}: {{ v | j }}
{% endfor %}
columns: {{ columns | j }}
key: {{ flow.key | j }}
control_totals: {{ control_totals | j }}
# A batch is written only when every record announced by its control message has arrived and
# the control totals match; records are written in source order.
order_by: source_sequence
