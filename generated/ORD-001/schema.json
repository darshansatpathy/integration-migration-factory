{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:imf:order.ord-001.v1",
  "title": "Daily orders to warehouse",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "order_date": {
      "type": "string",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "amount": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d{2}$",
      "description": "decimal, carried as a string to keep its precision"
    },
    "currency": {
      "type": "string"
    }
  },
  "required": [
    "order_id",
    "order_date",
    "customer_id",
    "customer_name",
    "amount",
    "currency"
  ],
  "additionalProperties": false
}
