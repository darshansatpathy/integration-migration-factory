{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:imf:inventory.inv-001.v1",
  "title": "Inventory snapshot to ERP",
  "type": "object",
  "properties": {
    "sku": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "on_hand": {
      "type": "integer"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "sku",
    "location",
    "on_hand",
    "description"
  ],
  "additionalProperties": false
}
