{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:imf:finance.invc-001.v1",
  "title": "Invoices to finance",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string",
      "minLength": 1
    },
    "invoice_date": {
      "type": "string",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
    },
    "customer_id": {
      "type": "string"
    },
    "net": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d{2}$",
      "description": "decimal, carried as a string to keep its precision"
    },
    "gross": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d{2}$",
      "description": "decimal, carried as a string to keep its precision"
    }
  },
  "required": [
    "invoice_id",
    "invoice_date",
    "customer_id",
    "net",
    "gross"
  ],
  "additionalProperties": false
}
