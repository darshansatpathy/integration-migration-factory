{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:imf:finance.pay-001.v1",
  "title": "Payment confirmations to ERP",
  "type": "object",
  "properties": {
    "payment_ref": {
      "type": "string",
      "minLength": 1
    },
    "invoice_id": {
      "type": "string"
    },
    "amount": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d{2}$",
      "description": "decimal, carried as a string to keep its precision"
    },
    "value_date": {
      "type": "string",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
    }
  },
  "required": [
    "payment_ref",
    "invoice_id",
    "amount",
    "value_date"
  ],
  "additionalProperties": false
}
