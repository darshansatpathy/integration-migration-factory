{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:imf:order.ord-002.v1",
  "title": "Order lines to warehouse",
  "type": "object",
  "properties": {
    "line_key": {
      "type": "string",
      "minLength": 1
    },
    "order_id": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "quantity": {
      "type": "integer"
    },
    "unit_price": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d{2}$",
      "description": "decimal, carried as a string to keep its precision"
    }
  },
  "required": [
    "line_key",
    "order_id",
    "sku",
    "quantity",
    "unit_price"
  ],
  "additionalProperties": false
}
